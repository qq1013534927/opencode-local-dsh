{
  "name": "@local/opencode-local",
  "version": "0.2.0",
  "private": true,
  "description": "Route DSH model calls through your own OpenCode account's Zen free models — never the shared anonymous lane. Bun-relay transport matches the CLI's TLS fingerprint for the healthy quota bucket.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "credential.js",
    "catalog.js",
    "adapter.js",
    "wire.js",
    "relay.mjs",
    "ids.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
