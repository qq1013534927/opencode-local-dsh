{
  "name": "@local/opencode-local",
  "version": "0.4.8",
  "private": true,
  "description": "Route DSH model calls through your own OpenCode account's Zen models - never the shared anonymous lane.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "client.js",
    "settings-bridge.js",
    "credential.js",
    "catalog.js",
    "adapter.js",
    "wire.js",
    "relay.mjs",
    "ids.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.4" },
  "license": "MIT"
}